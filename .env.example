# Base URL of the monitored Atlas backend (must be reachable from the deployment).
# Both service checks run through Atlas:
#   Atlas API -> GET /api/v1/system/health/atlas/
#   Hermes    -> GET /api/v1/system/health/hermes/
ATLAS_API_URL=http://localhost:8000

# Base URL of the ChirpStack network server (health + metrics probes on port 8083)
CHIRPSTACK_URL=http://localhost:8083

# Health-check URL of the Monitor Venus frontend (liveness endpoint serving "healthy").
# Default points at the built site on port 3000; the Vite dev server runs on port 5173.
VENUS_HEALTH_URL=http://localhost:3000/health

# Reserved for future persistence (required when historical monitoring lands)
# DATABASE_URL=