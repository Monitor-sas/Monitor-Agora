---
import { formatRelativeTime, formatResponseTime, getStatusLabel } from "../../lib/utils/status";
import type { ServiceStatusResult } from "../../types";

interface Props {
	service: ServiceStatusResult;
}

const { service } = Astro.props;

const error = service.checks.find((c) => c.error)?.error;

function detailsLine(): string | undefined {
	const d = service.details;
	if (!d) {
		return undefined;
	}

	const parts: string[] = [];

	if (typeof d.version === "string") {
		parts.push(`v${d.version}`);
	}
	if (typeof d.platform === "string") {
		parts.push(d.platform);
	}
	if (typeof d.api_latency_ms === "number") {
		parts.push(`API ${d.api_latency_ms}ms`);
	}
	if (typeof d.lastHeartbeatTs === "string") {
		parts.push(`beat ${formatRelativeTime(d.lastHeartbeatTs)}`);
	}

	return parts.length > 0 ? parts.join(" · ") : undefined;
}

const details = detailsLine();
---

<li class="service-row">
	<span class="service-name">
		<span class="status-indicator" data-status={service.status} aria-hidden="true"></span>
		<span class="service-name-text">
			<span class="service-name-label">{service.name}</span>
			{service.description && <span class="service-description">{service.description}</span>}
			{details && <span class="service-details">{details}</span>}
			{error && <span class="service-error">{error}</span>}
		</span>
	</span>
	<span class="service-meta">
		{service.responseTimeMs !== undefined && (
			<span class="service-time">{formatResponseTime(service.responseTimeMs)}</span>
		)}
		<span class="status-text" data-status={service.status}>
			{getStatusLabel(service.status)}
		</span>
	</span>
</li>